import { Loader2, Wand2 } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { MAX_FIELD_CHARS, type DebugInput, type Language } from "@/types/debug";

interface Props { value: DebugInput; onChange: (v: DebugInput) => void; onSubmit: () => void; loading: boolean }

export function InputPanel({ value, onChange, onSubmit, loading }: Props) {
  const set = (k: keyof DebugInput) => (e: React.ChangeEvent<HTMLTextAreaElement>) =>
    onChange({ ...value, [k]: e.target.value.slice(0, MAX_FIELD_CHARS) });
  const ready = value.request.trim() && value.error.trim();
  const field = (id: keyof DebugInput, label: string, ph: string, rows: number) => (
    <div className="space-y-1.5">
      <div className="flex justify-between">
        <Label htmlFor={id}>{label}</Label>
        <span className="text-xs text-muted-foreground">{(value[id] as string).length.toLocaleString()}/{MAX_FIELD_CHARS.toLocaleString()}</span>
      </div>
      <Textarea id={id} rows={rows} value={value[id] as string} onChange={set(id)} placeholder={ph} className="font-mono text-xs bg-code" spellCheck={false} />
    </div>
  );
  return (
    <section aria-label="Debug input" className="space-y-4 rounded-xl border bg-card p-4">
      {field("request", "Request / code", "Paste the failing request or code…", 9)}
      {field("error", "Error / response / logs", "Paste the error, response body or logs…", 7)}
      {field("docs", "API docs snippet (optional)", "Paste relevant docs to ground the fix…", 4)}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-end">
        <div className="space-y-1.5 sm:w-44">
          <Label htmlFor="lang">Fixed code language</Label>
          <Select value={value.language} onValueChange={(v) => onChange({ ...value, language: v as Language })}>
            <SelectTrigger id="lang" aria-label="Fixed code language"><SelectValue /></SelectTrigger>
            <SelectContent>
              <SelectItem value="python">Python</SelectItem>
              <SelectItem value="javascript">JavaScript</SelectItem>
              <SelectItem value="curl">cURL</SelectItem>
            </SelectContent>
          </Select>
        </div>
        <Button variant="hero" size="lg" className="flex-1" disabled={!ready || loading} onClick={onSubmit}>
          {loading ? <Loader2 className="animate-spin" /> : <Wand2 />} {loading ? "Investigating…" : "Debug with DevPilot"}
        </Button>
      </div>
    </section>
  );
}
