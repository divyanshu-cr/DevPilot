import { CheckCircle2, Circle, Loader2 } from "lucide-react";
import { TRACE_LABELS, type StepStatus, type TraceStep } from "@/types/debug";
import { cn } from "@/lib/utils";

export function AgentTrace({ steps, running }: { steps: TraceStep[]; running: boolean }) {
  return (
    <section aria-label="Agent trace" aria-live="polite" className="rounded-xl border bg-card p-4">
      <h2 className="mb-3 text-sm font-semibold">Agent Trace</h2>
      <ol className="space-y-3">
        {TRACE_LABELS.map((label, i) => {
          const s = steps[i];
          const status: StepStatus = s ? "done" : running && i === steps.length ? "running" : "pending";
          return (
            <li key={label} className={cn("flex gap-3 transition-opacity animate-in fade-in", status === "pending" && "opacity-50")}>
              {status === "done" ? <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-success" aria-label="done" />
                : status === "running" ? <Loader2 className="mt-0.5 h-5 w-5 shrink-0 animate-spin text-brand-to" aria-label="running" />
                : <Circle className="mt-0.5 h-5 w-5 shrink-0 text-muted-foreground" aria-label="pending" />}
              <div>
                <p className="text-sm font-medium">{label}</p>
                {s?.detail && <p className="text-xs text-muted-foreground animate-in fade-in slide-in-from-left-1">{s.detail}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  );
}
