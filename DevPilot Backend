import { createFileRoute } from "@tanstack/react-router";

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type",
};
const MAX = 20000;
const LANGS = { python: "Python (requests)", javascript: "JavaScript (fetch)", curl: "cURL" } as const;

const SYSTEM = `You are DevPilot, a senior API integration engineer who debugs failing API calls.
Rules:
- Use ONLY the evidence given (request/code, error/logs, optional docs). Do not invent API features, endpoints, or headers not supported by the evidence or widely-standard HTTP behavior. If unsure, lower confidence.
- fixed_code must be complete, runnable code in the requested language only, with no markdown fences inside the string.
- explanation is beginner-friendly, 2-4 sentences, and includes a short everyday analogy.
- Respond with ONLY a JSON object (no markdown) with keys in THIS order:
{"steps":[5 objects {"id","label","detail"} with ids "parse","identify","check","root_cause","fix" and labels exactly "Parsing request","Identifying API & auth method","Checking headers/body/status code","Finding root cause","Generating fix"; detail = one concise finding sentence],
"status_code": number|null,
"error_type": one of "401","403","404","422","429","500","CORS","CONTENT_TYPE","MALFORMED_BODY","TIMEOUT","OTHER",
"title": short diagnosis title,
"root_cause": 1-3 sentences,
"explanation": string,
"fixed_code": string,
"prevention_tips": 3-5 short strings,
"confidence": integer 0-100}`;

const json = (body: unknown, status: number) =>
  new Response(JSON.stringify(body), { status, headers: { ...CORS, "Content-Type": "application/json" } });

export const Route = createFileRoute("/api/debug-api")({
  server: {
    handlers: {
      OPTIONS: async () => new Response(null, { status: 204, headers: CORS }),
      POST: async ({ request }) => {
        let body: Record<string, unknown>;
        try { body = await request.json(); } catch { return json({ error: "Invalid request body." }, 400); }
        const req = typeof body.request === "string" ? body.request.trim() : "";
        const err = typeof body.error === "string" ? body.error.trim() : "";
        const docs = typeof body.docs === "string" ? body.docs.trim() : "";
        const lang = (body.language as keyof typeof LANGS) in LANGS ? (body.language as keyof typeof LANGS) : "python";
        if (!req || !err) return json({ error: "Request and error fields are required." }, 400);
        if (req.length > MAX || err.length > MAX || docs.length > MAX)
          return json({ error: `Each field must be under ${MAX.toLocaleString()} characters.` }, 413);

        const key = process.env.LOVABLE_API_KEY;
        if (!key) return json({ error: "AI is not configured." }, 500);

        const user = `Fixed code language: ${LANGS[lang]}\n\n### Request / code\n${req}\n\n### Error / response / logs\n${err}\n\n### API docs snippet\n${docs || "(none provided)"}`;
        const upstream = await fetch("https://ai.gateway.lovable.dev/v1/chat/completions", {
          method: "POST",
          headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json", "X-Lovable-AIG-SDK": "fetch" },
          body: JSON.stringify({
            model: "google/gemini-2.5-flash",
            stream: true,
            messages: [{ role: "system", content: SYSTEM }, { role: "user", content: user }],
          }),
          signal: request.signal,
        });
        if (!upstream.ok || !upstream.body) {
          const s = upstream.status;
          const msg = s === 429 ? "DevPilot is getting a lot of requests right now. Please wait a moment and retry."
            : s === 402 ? "AI credits are used up for this workspace. Add credits to keep debugging."
            : s === 403 ? "AI access is blocked for this workspace."
            : "The AI service had a problem. Please retry.";
          return json({ error: msg }, s === 429 || s === 402 || s === 403 ? s : 502);
        }
        return new Response(upstream.body, {
          headers: { ...CORS, "Content-Type": "text/event-stream", "Cache-Control": "no-cache, no-transform" },
        });
      },
    },
  },
});
