interface Props { result: DebugResult | null; loading: boolean; error: string | null; language: Language; onRetry: () => void }

export function ResultCards({ result, loading, error, language, onRetry }: Props) {
  if (error) return (
    <div role="alert" className="rounded-xl border border-destructive/50 bg-card p-5 text-center">
      <AlertTriangle className="mx-auto mb-2 h-6 w-6 text-destructive" />
      <p className="text-sm">{error}</p>
      <Button variant="outline" size="sm" className="mt-3" onClick={onRetry}><RotateCcw /> Retry</Button>
    </div>
  );
  if (loading) return (
    <div className="space-y-3" aria-busy="true" aria-label="Loading results">
      {[0, 1, 2].map((i) => <div key={i} className="rounded-xl border bg-card p-4 space-y-2"><Skeleton className="h-4 w-32" /><Skeleton className="h-3 w-full" /><Skeleton className="h-3 w-4/5" /></div>)}
    </div>
  );
  if (!result) return (
    <div className="rounded-xl border border-dashed p-8 text-center text-muted-foreground">
      <Telescope className="mx-auto mb-2 h-7 w-7" />
      <p className="text-sm">Paste a failing request and error, or pick a quick example, then hit Debug.</p>
    </div>
  );
  const c = result.confidence;
  const level = c >= 75 ? "High" : c >= 45 ? "Medium" : "Low";
  return (
    <div className="space-y-3">
      <div className="flex flex-wrap items-center justify-between gap-2">
        <h2 className="text-lg font-semibold">{result.title}</h2>
        <div className="flex gap-2">
          <span className="rounded-full border px-2.5 py-0.5 font-mono text-xs">{result.status_code ?? "—"} · {result.error_type}</span>
          <span className={cn("rounded-full px-2.5 py-0.5 text-xs font-semibold text-background",
            level === "High" ? "bg-success" : level === "Medium" ? "bg-warning" : "bg-destructive")}>
            {level} confidence · {c}%
          </span>
        </div>
      </div>
      <Card icon={AlertTriangle} title="Root Cause"><p className="text-sm">{result.root_cause}</p></Card>
      <Card icon={BookOpen} title="Why it happened (beginner-friendly)"><p className="text-sm text-muted-foreground">{result.explanation}</p></Card>
      <Card icon={Code2} title="Fixed Code"><CodeBlock code={result.fixed_code} language={language} /></Card>
      <Card icon={Lightbulb} title="Prevention Tips">
        <ul className="space-y-1.5">{result.prevention_tips.map((t, i) => <li key={i} className="flex gap-2 text-sm"><ShieldCheck className="mt-0.5 h-4 w-4 shrink-0 text-success" />{t}</li>)}</ul>
      </Card>
    </div>
  );
}
