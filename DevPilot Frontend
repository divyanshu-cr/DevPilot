  --card: oklch(0.2 0.014 264);
  --card-foreground: oklch(0.96 0.005 264);
  --popover: oklch(0.2 0.014 264);
  --popover-foreground: oklch(0.96 0.005 264);
  --primary: oklch(0.62 0.2 275);
  --primary-foreground: oklch(0.99 0 0);
  --secondary: oklch(0.26 0.016 264);
  --secondary-foreground: oklch(0.96 0.005 264);
  --muted: oklch(0.24 0.014 264);
